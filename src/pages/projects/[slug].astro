---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { sitePath } from '../../lib/paths';
import { projects } from '../../data/projects';
export function getStaticPaths() { return projects.map((project) => ({ params: { slug: project.slug }, props: { project } })); }
const { project } = Astro.props;
---
<BaseLayout title={project.title} description={project.summary}>
  <article class="archive-shell page-shell project-detail">
    <a class="back-link" href={sitePath('/projects/')}>← 프로젝트 목록</a>
    <div class:list={['detail-cover', 'project-cover', { 'has-image': Boolean(project.image), wide: project.imageMode === 'wide' }]} style={`--cover:${project.color}`}>
      {project.image ? (project.imageMode === 'wide' ? <img class="cover-image" src={sitePath(project.image)} alt={project.imageAlt ?? `${project.name} 화면`} /> : <><div class="image-caption"><span class="cover-name">{project.name}</span><span>프로젝트 화면</span></div><img class="cover-image" src={sitePath(project.image)} alt={project.imageAlt ?? `${project.name} 화면`} /></>) : <><span class="cover-name">{project.name}</span><span class="cover-mark">{project.mark}</span><span class="cover-caption">작업 기록　·　{project.period}</span></>}
    </div>
    <header class="detail-header"><p class="eyebrow">{project.period} <span>·</span> {project.type}</p><h1>{project.title}</h1><p class="detail-lede">{project.summary}</p></header>
    <div class="detail-body"><section class="detail-copy"><h2>작업에 대하여</h2><p>{project.description}</p></section><aside class="project-facts"><div><span>역할</span><p>{project.role}</p></div><div><span>사용 도구</span><p>{project.stack.join(' · ')}</p></div>{project.links.map((link) => <div><span>링크</span><p><a href={link.href}>{link.label} ↗</a></p></div>)}</aside></div>
    {project.slug === 'ai-dlc-si-portfolio' && <div class="detail-note"><a class="text-link" href={sitePath('/posts/ai-dlc-si-portfolio/')}>프로젝트 기록 읽기 <span aria-hidden="true">↗</span></a></div>}
    {project.slug === 'ai-development-orchestrator' && <div class="detail-note"><a class="text-link" href={sitePath('/posts/ai-development-orchestrator/')}>프로젝트 기록 읽기 <span aria-hidden="true">↗</span></a></div>}
    {project.slug === 'cycling-adviser' && <div class="detail-note"><a class="text-link" href={sitePath('/posts/cycling-adviser/')}>프로젝트 소개 읽기 <span aria-hidden="true">↗</span></a></div>}
    {project.slug === 'weather-proxy' && <div class="detail-note"><a class="text-link" href={sitePath('/posts/weather-proxy/')}>프로젝트 소개 읽기 <span aria-hidden="true">↗</span></a></div>}
    {project.slug === 'status-relay' && <div class="detail-note"><a class="text-link" href={sitePath('/posts/status-relay/')}>이 프로젝트를 만들며 정리한 글 읽기 <span aria-hidden="true">↗</span></a></div>}
    {project.slug === 'wired-keyboard-transfer-dongle' && <div class="detail-note"><a class="text-link" href={sitePath('/posts/wired-keyboard-transfer-dongle/')}>기획과 현재 검증 단계 읽기 <span aria-hidden="true">↗</span></a></div>}
    {project.slug === 'marknaroo' && <div class="detail-note"><a class="text-link" href={sitePath('/posts/marknaroo/')}>공유 코어와 두 앱 형태에 대한 글 읽기 <span aria-hidden="true">↗</span></a></div>}
    {project.slug === 'status-relay-rebuild' && <div class="detail-note"><a class="text-link" href={sitePath('/posts/status-relay-rebuild/')}>일시중단 작업 기록 읽기 <span aria-hidden="true">↗</span></a></div>}
  </article>
</BaseLayout>
