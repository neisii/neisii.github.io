---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { sitePath } from '../../lib/paths';
import { getCollection } from 'astro:content';
const posts = (await getCollection('posts')).filter((post) => post.data.kind === 'article').sort((a, b) => b.data.date.localeCompare(a.data.date));
---
<BaseLayout title="글" description="프로젝트를 만들며 배운 것과 생각을 기록합니다.">
  <div class="archive-shell page-shell">
    <header class="page-intro"><p class="eyebrow">02 / WRITING</p><h1>글</h1><p>만드는 과정에서 발견한 것과 오래 생각한 것을 기록합니다.</p></header>
    <ul class="entry-list post-list">{posts.map((post) => <li><a href={sitePath(`/posts/${post.slug}/`)}><time datetime={post.data.date}>{post.data.date}</time><span class="entry-content"><span class="entry-title">{post.data.title}</span>{post.data.description && <span class="entry-description">{post.data.description}</span>}</span><span class="entry-arrow" aria-hidden="true">↗</span></a></li>)}</ul>
  </div>
</BaseLayout>
