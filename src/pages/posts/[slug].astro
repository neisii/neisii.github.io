---
import { getCollection } from 'astro:content';
import PostLayout from '../../layouts/PostLayout.astro';
import { sitePath } from '../../lib/paths';
export async function getStaticPaths() { const posts = await getCollection('posts'); return posts.map((post) => ({ params: { slug: post.slug } })); }
const { slug } = Astro.params;
const post = await getCollection('posts').then((items) => items.find((item) => item.slug === slug));
if (!post) throw new Error(`Post not found for slug: ${slug}`);
const { Content, headings } = await post.render();
---
<PostLayout title={post.data.title} description={post.data.description ?? ''}>
  <div class="archive-shell page-shell article-shell">
    <a class="back-link" href={sitePath('/posts/')}>← 글 목록</a>
    <article>
      <header class="article-header"><p class="eyebrow">FIELD NOTES <span>·</span> {post.data.date}</p><h1>{post.data.title}</h1>{post.data.description && <p class="article-description">{post.data.description}</p>}
        {post.data.tags?.length > 0 && <div class="tag-row">{post.data.tags.map((tag) => <a href={sitePath(`/tags/${tag}/`)}>#{tag}</a>)}</div>}
      </header>
      <div class="article-layout"><div class="article-body"><Content /></div><aside class="article-toc"><nav class="toc" aria-label="목차"><p class="eyebrow">ON THIS PAGE</p><ul>{headings.filter((heading) => heading.depth === 2 || heading.depth === 3).map((heading) => <li class:list={{ nested: heading.depth === 3 }}><a href={`#${heading.slug}`}>{heading.text}</a></li>)}</ul></nav></aside></div>
    </article>
  </div>
</PostLayout>
