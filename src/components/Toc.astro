---
const { headings = [] } = Astro.props;
const items = headings.filter((heading) => heading.depth === 2 || heading.depth === 3);
---
{items.length > 0 && <nav class="toc" aria-label="목차"><p class="eyebrow">ON THIS PAGE</p><ul>{items.map((heading) => <li class:list={{ nested: heading.depth === 3 }}><a href={`#${heading.slug}`}>{heading.text}</a></li>)}</ul></nav>}
